10 REM Comprehensive Physics Demo with Tower Collapse
20 CLS

30 REM Initialisiere Physics
40 PHYSICS WORLD 0, 300
50 PHYSICS SCALE 30

60 REM Erstelle Boden und Wände
70 PHYSICS FLOOR 0, 450, 640, 450
80 PHYSICS WALL 0, 0, 0, 480
90 PHYSICS WALL 640, 0, 640, 480

100 REM Baue Turm in der Mitte
110 LET BLOCK_WIDTH = 35
120 LET BLOCK_HEIGHT = 18
130 LET TOWER_BASE_X = 320 - (2 * BLOCK_WIDTH)
140 LET TOWER_BASE_Y = 400
150 LET RECT_ID = 100

160 FOR ROW = 0 TO 6
170   FOR COL = 0 TO 3
180     LET X = TOWER_BASE_X + COL * BLOCK_WIDTH
190     LET Y = TOWER_BASE_Y - ROW * BLOCK_HEIGHT
200     LET COLOR = 7 + (ROW MOD 5)
210     RECT X, Y, BLOCK_WIDTH, BLOCK_HEIGHT, COLOR, 1
220     PHYSICS RECT X, Y, BLOCK_WIDTH, BLOCK_HEIGHT, RECT_ID, "dynamic"
230     PHYSICS DENSITY RECT_ID, 1.2
240     PHYSICS FRICTION RECT_ID, 0.7
250     PHYSICS BOUNCE RECT_ID, 0.0
260     LET RECT_ID = RECT_ID + 1
270   NEXT COL
280 NEXT ROW

290 REM Erstelle fallende Bälle
300 CIRCLE 200, 100, 20, 4, 1
310 PHYSICS CIRCLE 200, 100, 20, 1
320 PHYSICS BOUNCE 1, 0.0
330 PHYSICS FRICTION 1, 0.3
